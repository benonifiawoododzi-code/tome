# This file is safe to publish. It holds names only.
# Copy it to .env.local and put the real values there.
# .env.local stays off GitHub. Never paste a live key into this file.
# Names that start with NEXT_PUBLIC_ are sent to the browser.
# Every other name stays on the server.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

RESEND_API_KEY=
RESEND_FROM=Tome Accra <onboarding@resend.dev>
TAYSEND_API_KEY=
TAYSEND_SENDER_ID=TomeAccra
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_EMAIL=hello@tomebooks.gh
